{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/predict.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/users.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/sensor-data",
      "dest": "/api/predict.py"
    },
    {
      "src": "/api/predict",
      "dest": "/api/predict.py"
    },
    {
      "src": "/api/historical-data",
      "dest": "/api/predict.py"
    },
    {
      "src": "/api/machine-status",
      "dest": "/api/predict.py"
    },
    {
      "src": "/api/users",
      "dest": "/api/users.py"
    },
    {
      "src": "/api/users/(.*)",
      "dest": "/api/users.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/predict.py": {
      "maxDuration": 30
    },
    "api/users.py": {
      "maxDuration": 10
    }
  }
}